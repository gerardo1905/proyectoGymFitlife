# IMPORTANTE: este archivo se debe copiar como ".env" (punto env), no "..env".
# En el servidor de AWS usar DEBUG=False.
DEBUG=True
# Generar una con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=tu_secret_key_aqui
ALLOWED_HOSTS=localhost,127.0.0.1
# Agregar aqui la URL publica (IP o dominio) con http:// o https:// cuando se suba a AWS
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Poner True solo cuando el sitio tenga HTTPS
USAR_HTTPS=False

# ---- API REST ----
# URL(s) del FRONTEND autorizadas a llamar la API desde el navegador (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Secreto que API Gateway agrega en la cabecera X-Gateway-Secret.
# Dejar vacio en local. En AWS: un texto largo aleatorio (el mismo configurado en API Gateway).
API_GATEWAY_SECRET=
# Ruta del admin de Django (en AWS conviene algo menos obvio que admin/)
ADMIN_URL=admin/
# Duracion de los tokens JWT
JWT_ACCESS_MINUTOS=30
JWT_REFRESH_HORAS=10

# ---- S3 (solo en AWS) ----
USE_S3=False
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

DB_NAME=fitlife_db
DB_USER=tu_usuario_postgres
DB_PASSWORD=tu_password_postgres
DB_HOST=localhost
DB_PORT=5432
# 'prefer' en local; 'require' si la BD es Amazon RDS
DB_SSLMODE=prefer

# Correo para el envio automatico del QR de acceso al socio.
# Si se deja en blanco, el sistema sigue funcionando: el correo solo
# se imprime en la consola/terminal en vez de enviarse de verdad.
# Con Gmail, EMAIL_HOST_PASSWORD debe ser una "contraseña de aplicacion",
# no tu contraseña normal de la cuenta.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=FitLife Gimnasio <tu_correo@gmail.com>