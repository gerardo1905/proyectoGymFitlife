# Entorno Virtual (¡Lo más pesado! No debe subirse)
venv/
env/
ENV/

# Archivos de caché y compilados de Python
__pycache__/
*.py[cod]
*$py.class

# Base de datos local SQLite (si existiera alguna de prueba)
*.sqlite3

# Archivos estáticos recolectados (en el servidor en AWS se generarán con collectstatic)
staticfiles/
static_root/

# Archivos subidos por usuarios
media/

# Archivos de configuración local / Secretos
..env
.env
.DS_Store
.vscode/
.idea/

# Logs del sistema
*.log
# Dependencias de Node (no pertenecen al backend)
node_modules/
package-lock.json

# Carpeta generada por el asistente en el escritorio (no es parte del proyecto)
Claude outputs/
